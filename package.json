{
  "name": "ng-craft-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "update": "npm i @craft-ng/core@latest @craft-ng/component@latest @craft-ng/dev-tools@latest",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@craft-ng/core": "0.7.0-beta.11",
    "tslib": "^2.3.0",
    "@craft-ng/dev-tools": "0.7.0-beta.11",
    "@craft-ng/component": "0.7.0-beta.11"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "@eslint/js": "^9.8.0",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.8.0",
    "typescript-eslint": "^8.40.0"
  }
}
